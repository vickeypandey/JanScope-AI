# Copy this file to .env. Never upload the real .env file to GitHub.

# Safe default: the whole project works without an API key.
AI_ENABLED=false
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
GEMINI_TEMPERATURE=0.15
GEMINI_MAX_OUTPUT_TOKENS=1400
GEMINI_REQUEST_TIMEOUT_SECONDS=12

# Local application
ENVIRONMENT=development
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=8501
FRONTEND_URL=http://127.0.0.1:8501
ALLOW_ORIGINS=http://127.0.0.1:8501,http://localhost:8501

# Local persistence
DATABASE_URL=sqlite:///./data/janscope.db
SEED_SAMPLE_DATA=false
VECTOR_BACKEND=chroma
CHROMA_PATH=./data/chroma
VECTOR_COLLECTION=janscope_scheme_documents
RETRIEVAL_TOP_K=4

LOG_LEVEL=INFO

# Public deployment safeguards
CHAT_RATE_LIMIT_PER_MINUTE=10
GRIEVANCE_RATE_LIMIT_PER_MINUTE=3
MAX_REQUEST_BYTES=131072
TRUST_PROXY_HEADERS=false
INGESTION_ENABLED=false
ADMIN_API_KEY=
CONVERSATION_ACCESS_SECRET=development-only-change-me
PROJECT_GITHUB_URL=
API_DOCS_ENABLED=true
LIVE_SOURCE_SYNC_ENABLED=false
LIVE_SYNC_INTERVAL_HOURS=24
LIVE_SYNC_MAX_PAGES=25
OFFICIAL_FETCH_TIMEOUT_SECONDS=15
OFFICIAL_FETCH_DELAY_SECONDS=0.25
OFFICIAL_SOURCE_DOMAINS_CSV=myscheme.gov.in,india.gov.in
OFFICIAL_BOOTSTRAP_URLS_CSV=https://www.myscheme.gov.in/schemes/aaby,https://www.myscheme.gov.in/schemes/pm-kisan,https://www.myscheme.gov.in/schemes/smile-scholarship,https://www.myscheme.gov.in/schemes/intss,https://www.myscheme.gov.in/schemes/free-ug-students-only,https://www.myscheme.gov.in/schemes/scss,https://www.myscheme.gov.in/schemes/specs,https://www.myscheme.gov.in/schemes/rsds,https://www.myscheme.gov.in/schemes/wsfw
MYSCHEME_PUBLIC_API_KEY=

# Passwordless email authentication. Development mode shows the OTP on screen.
# For deployment, use Brevo's HTTPS API on hosts that block SMTP ports.
AUTH_ENABLED=true
OTP_DELIVERY_MODE=development
OTP_SECRET=development-only-otp-secret-change-me

OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
AUTH_SESSION_DAYS=7

BREVO_API_KEY=
SMTP_FROM_EMAIL=

# Optional SMTP delivery for hosts that allow outbound SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
