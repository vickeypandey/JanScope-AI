# Copy these names into your hosting provider's encrypted secret/environment settings.
# Never commit real values.
ENVIRONMENT=production
AI_ENABLED=true
AI_PROVIDER=gemini
GEMINI_API_KEY=replace-with-host-secret
GEMINI_MODEL=gemini-3.7-flash
GEMINI_REQUEST_TIMEOUT_SECONDS=12

SEED_SAMPLE_DATA=false
INGESTION_ENABLED=false
ADMIN_API_KEY=replace-with-at-least-24-random-characters
CONVERSATION_ACCESS_SECRET=replace-with-at-least-32-random-characters

ALLOW_ORIGINS=https://your-frontend.example
FRONTEND_URL=https://your-frontend.example
PROJECT_GITHUB_URL=https://github.com/your-account/your-repository
API_DOCS_ENABLED=false
LIVE_SOURCE_SYNC_ENABLED=true
LIVE_SYNC_INTERVAL_HOURS=24
LIVE_SYNC_MAX_PAGES=25
OFFICIAL_FETCH_TIMEOUT_SECONDS=15
OFFICIAL_FETCH_DELAY_SECONDS=0.25
OFFICIAL_SOURCE_DOMAINS_CSV=myscheme.gov.in,india.gov.in
OFFICIAL_BOOTSTRAP_URLS_CSV=https://www.myscheme.gov.in/schemes/aaby,https://www.myscheme.gov.in/schemes/pm-kisan,https://www.myscheme.gov.in/schemes/smile-scholarship,https://www.myscheme.gov.in/schemes/intss,https://www.myscheme.gov.in/schemes/free-ug-students-only,https://www.myscheme.gov.in/schemes/scss,https://www.myscheme.gov.in/schemes/specs,https://www.myscheme.gov.in/schemes/rsds,https://www.myscheme.gov.in/schemes/wsfw
MYSCHEME_PUBLIC_API_KEY=copy-current-public-client-key-from-myscheme-web-app

# Passwordless email OTP (Brevo, Mailgun, SendGrid, Amazon SES, etc.)
AUTH_ENABLED=true
OTP_DELIVERY_MODE=smtp
OTP_SECRET=vickey_pandey_development-only-otp-secret-change-me

OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
AUTH_SESSION_DAYS=7

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=b711ee001@smtp-brevo.com
SMTP_PASSWORD=replace-with-smtp-password
SMTP_USE_TLS=true
